import { VerticalBox, HorizontalBox, TextEdit, Slider, ComboBox, ScrollView, Palette } from "std-widgets.slint";

// =============================================================
// Cardboard++ Bridge — the product UI.
//
// Widget style is pinned to fluent-dark at compile time (build.rs);
// rounded buttons, sized inputs, and titled settings sections.
// =============================================================

// ---- A status pill shown in the top bar ---------------------
component StatusChip inherits Rectangle {
    in property <string> label;
    in property <color> dot: #7d7d8a;
    height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: #23232e;
    border-width: 1px;
    border-color: #30303c;
    border-radius: 13px;

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.dot;
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: #c9c9d6;
            vertical-alignment: center;
        }
    }
}

// ---- Side-bar navigation button ------------------------------
component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 38px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 10px;
    background: active ? #242f42 : transparent;

    Rectangle {
        x: 0;
        y: (parent.height - 22px) / 2;
        width: 3px;
        height: 22px;
        border-radius: 2px;
        background: active ? #6ea8ff : transparent;
    }

    Text {
        x: 16px;
        y: 0;
        width: parent.width - 16px;
        height: 100%;
        text: root.text;
        font-size: 13px;
        font-weight: 600;
        color: active ? #9fc0ff : #9494a2;
        vertical-alignment: center;
    }

    TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---- Rounded action button -----------------------------------
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> variant: "primary"; // primary | neutral | danger | success
    in property <bool> disabled: false;
    callback clicked;
    height: 38px;
    min-width: 128px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 10px;

    states [
        disabled when root.disabled : {
            i-bg.background: #26262f;
            i-border.border-color: transparent;
            i-label.color: #62626e;
        }
        pressed when i-ta.pressed : {
            i-bg.background:
                root.variant == "danger" ? #bd3b42 :
                root.variant == "success" ? #279a5b :
                root.variant == "neutral" ? #292934 :
                #4174c9;
        }
        hover when i-ta.has-hover : {
            i-bg.background:
                root.variant == "danger" ? #ea515a :
                root.variant == "success" ? #39bc74 :
                root.variant == "neutral" ? #34343f :
                #5b93ef;
        }
    ]

    i-bg := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        background:
            root.variant == "danger" ? #d9434b :
            root.variant == "success" ? #2fab64 :
            root.variant == "neutral" ? #2c2c38 :
            #4d8ae8;
        animate background { duration: 120ms; }

        i-border := Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            border-width: 1px;
            border-color: root.variant == "neutral" ? #3d3d4b : transparent;
        }

        i-label := Text {
            width: 100%;
            height: 100%;
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.variant == "neutral" ? #d4d4e0 : #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    i-ta := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---- Raised card used to group settings ----------------------
component Panel inherits Rectangle {
    horizontal-stretch: 1;
    background: #1d1d27;
    border-width: 1px;
    border-color: #2b2b36;
    border-radius: 12px;
}

component SectionTitle inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: #c9c9d6;
}

component HintText inherits Text {
    font-size: 11px;
    color: #7d7d8a;
    wrap: word-wrap;
}

component ValueText inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: #9fc0ff;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// =============================================================
// Main window
// =============================================================
export component MainWindow inherits Window {
    // The widget style is pinned to fluent-dark in build.rs, so no explicit
    // palette switching is needed here.

    title: "Cardboard++ Bridge";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 1000px;
    min-height: 680px;
    background: #0f0f15;

    // ---- Tab (0=Stream, 1=Camera, 2=General, 3=Diagnostics) ----
    in-out property <int> current_tab: 0;

    // ---- Top bar (live) ----
    in property <string> connection_status: "Idle";
    in property <string> live_fps: "0.0 fps";
    in property <string> stream_state: "Stopped";
    in property <string> client_state: "No client";

    // ---- Diagnostics pane ----
    in property <string> diagnostics: "";

    // ---- Stream settings (owned by the bridge; pushed to the driver) ----
    in-out property <string> stream_width_s: "2880";
    in-out property <string> stream_height_s: "1620";
    in-out property <int> stream_fps: 60;
    in-out property <int> stream_bitrate_kbps: 20000;
    in-out property <int> stream_encoder: 0;
    in property <bool> stream_enabled: true;
    in property <string> telemetry_line: "no encoder telemetry yet";

    // ---- Camera (placeholder) ----
    in property <string> camera_status: "Placeholder - hand tracking ships with the stream";

    // ---- General (installers + config) ----
    in property <string> general_status: "Ready";
    in-out property <string> driver_dll_src: "C:/Users/admin000/StudioProjects/cardboardplusplus/driver_cardboardplusplus/x64/Release/driver_cardboardplusplus.dll";
    in-out property <string> steamvr_drivers_dir: "C:/Program Files (x86)/Steam/steamapps/common/SteamVR/drivers/cardboardplusplus";
    in-out property <string> apk_path: "C:/Users/admin000/StudioProjects/cardboardplusplus/cardboardplusplus-android/build/outputs/apk/debug/app-debug.apk";
    in-out property <string> adb_path: "C:/Users/admin000/AppData/Local/Android/Sdk/platform-tools/adb.exe";
    in-out property <string> phone_endpoint: "100.103.133.73:37269";

    // ---- Callbacks into Rust ----
    callback apply_settings();
    callback toggle_stream();
    callback build_driver();
    callback install_driver();
    callback install_apk();
    callback start_steamvr();

    VerticalBox {
        // ===================== TOP BAR =====================
        Rectangle {
            height: 54px;
            background: #16161e;

            HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                alignment: center;

                HorizontalBox {
                    spacing: 9px;
                    alignment: center;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 4px;
                        background: #4d8ae8;
                    }
                    Text {
                        text: "Cardboard++ Bridge";
                        font-size: 15px;
                        font-weight: 700;
                        color: #e8e8f0;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                StatusChip {
                    label: "Driver · \{connection_status}";
                    dot: connection_status == "Connected" ? #3ecf7b : (connection_status == "Error" ? #f0564f : #7d7d8a);
                }
                StatusChip {
                    label: "FPS · \{live_fps}";
                    dot: #9fc0ff;
                }
                StatusChip {
                    label: "Stream · \{stream_state}";
                    dot: stream_state == "Stopped" ? #7d7d8a : #3ecf7b;
                }
                StatusChip {
                    label: "Client · \{client_state}";
                    dot: client_state == "Connected" ? #3ecf7b : #7d7d8a;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #24242f;
        }

        // ===================== BODY =====================
        HorizontalBox {
            padding: 12px;
            spacing: 12px;

            // ---------- SIDE BAR ----------
            Rectangle {
                width: 214px;
                horizontal-stretch: 0;
                border-radius: 14px;
                background: #14141b;

                VerticalBox {
                    padding: 14px;
                    spacing: 6px;

                    Text {
                        text: "BRIDGE";
                        font-size: 12px;
                        font-weight: 700;
                        color: #6f6f7d;
                    }

                    NavButton { text: "Stream";      active: current_tab == 0; clicked() => { current_tab = 0; } }
                    NavButton { text: "Camera";      active: current_tab == 1; clicked() => { current_tab = 1; } }
                    NavButton { text: "General";     active: current_tab == 2; clicked() => { current_tab = 2; } }
                    NavButton { text: "Diagnostics"; active: current_tab == 3; clicked() => { current_tab = 3; } }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "video · UDP\nhand tracking · MediaPipe";
                        font-size: 10px;
                        color: #5b5b68;
                        wrap: word-wrap;
                    }
                }
            }

            // ---------- CONTENT ----------
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 14px;
                background: #17171f;
                clip: true;

                ScrollView {
                    // ==================== STREAM ====================
                    if current_tab == 0 : VerticalBox {
                        padding: 20px;
                        spacing: 14px;

                        Text { text: "STREAM"; font-size: 21px; font-weight: 700; color: #ebebf3; }
                        Text {
                            text: "Encoding & delivery — settings are owned here and pushed to the SteamVR driver.";
                            font-size: 12px;
                            color: #85858f;
                        }

                        Panel {
                            VerticalBox {
                                padding: 18px;
                                spacing: 12px;

                                SectionTitle { text: "Resolution (SBS width × height)"; }
                                HorizontalBox {
                                    spacing: 10px;
                                    TextEdit {
                                        text: stream_width_s;
                                        placeholder-text: "width (e.g. 2880)";
                                        edited(t) => { stream_width_s = t; }
                                        height: 34px;
                                        vertical-stretch: 0;
                                    }
                                    Text {
                                        text: "×";
                                        width: 18px;
                                        font-size: 14px;
                                        color: #6f6f7d;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TextEdit {
                                        text: stream_height_s;
                                        placeholder-text: "height (e.g. 1620)";
                                        edited(t) => { stream_height_s = t; }
                                        height: 34px;
                                        vertical-stretch: 0;
                                    }
                                }

                                Rectangle { height: 1px; background: #2b2b36; }

                                HorizontalBox {
                                    spacing: 14px;
                                    SectionTitle { text: "Speed / FPS"; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    ValueText { text: "\{stream_fps} fps"; }
                                }
                                Slider {
                                    minimum: 30;
                                    maximum: 120;
                                    value: stream_fps;
                                    changed(v) => { stream_fps = v; }
                                }

                                Rectangle { height: 1px; background: #2b2b36; }

                                HorizontalBox {
                                    spacing: 14px;
                                    SectionTitle { text: "Bitrate"; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    ValueText { text: "\{stream_bitrate_kbps} kbps"; }
                                }
                                Slider {
                                    minimum: 2000;
                                    maximum: 60000;
                                    value: stream_bitrate_kbps;
                                    changed(v) => { stream_bitrate_kbps = v; }
                                }

                                Rectangle { height: 1px; background: #2b2b36; }

                                SectionTitle { text: "Encoder"; }
                                ComboBox {
                                    model: ["Software (libx264)", "GPU (NVENC/AMF)"];
                                    current-index: stream_encoder;
                                    selected(v) => { stream_encoder = v == "GPU (NVENC/AMF)" ? 1 : 0; }
                                }
                            }
                        }

                        HintText { text: telemetry_line; }

                        HorizontalBox {
                            spacing: 12px;
                            alignment: end;
                            ActionButton {
                                text: "Apply & push to driver";
                                variant: "primary";
                                clicked() => { apply_settings(); }
                            }
                            ActionButton {
                                text: stream_enabled ? "Stop stream" : "Start stream";
                                variant: stream_enabled ? "danger" : "success";
                                min-width: 150px;
                                clicked() => { toggle_stream(); }
                            }
                        }
                    }

                    // ==================== CAMERA ====================
                    if current_tab == 1 : VerticalBox {
                        padding: 20px;
                        spacing: 14px;

                        Text { text: "CAMERA"; font-size: 21px; font-weight: 700; color: #ebebf3; }
                        Text {
                            text: "Phone camera passthrough + MediaPipe hand tracking.";
                            font-size: 12px;
                            color: #85858f;
                        }

                        Panel {
                            VerticalBox {
                                padding: 18px;
                                spacing: 10px;
                                SectionTitle { text: "Status"; }
                                HintText { text: camera_status; font-size: 12px; }
                            }
                        }

                        HintText {
                            text: "Hand tracking ships together with the stream — the Bridge is the single switch for both."; }
                    }

                    // ==================== GENERAL ====================
                    if current_tab == 2 : VerticalBox {
                        padding: 20px;
                        spacing: 14px;

                        Text { text: "GENERAL"; font-size: 21px; font-weight: 700; color: #ebebf3; }
                        Text {
                            text: "One-click installer / updater for the whole product (driver DLL + Android APK).";
                            font-size: 12px;
                            color: #85858f;
                        }

                        Panel {
                            VerticalBox {
                                padding: 18px;
                                spacing: 10px;

                                SectionTitle { text: "SteamVR driver"; }
                                HintText { text: "Built DLL → install dir (any current driver is backed up first)."; }
                                TextEdit {
                                    text: driver_dll_src;
                                    edited(t) => { driver_dll_src = t; }
                                    height: 34px;
                                    vertical-stretch: 0;
                                }
                                HintText { text: "Install directory: SteamVR\\drivers\\cardboardplusplus"; }
                                TextEdit {
                                    text: steamvr_drivers_dir;
                                    edited(t) => { steamvr_drivers_dir = t; }
                                    height: 34px;
                                    vertical-stretch: 0;
                                }
                                HorizontalBox {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Build driver (MSVC)";
                                        variant: "neutral";
                                        min-width: 180px;
                                        clicked() => { build_driver(); }
                                    }
                                    ActionButton {
                                        text: "Install / update driver";
                                        variant: "primary";
                                        min-width: 200px;
                                        clicked() => { install_driver(); }
                                    }
                                }
                            }
                        }

                        Panel {
                            VerticalBox {
                                padding: 18px;
                                spacing: 10px;

                                SectionTitle { text: "Android client"; }
                                HintText { text: "APK path (built artifact)."; }
                                TextEdit {
                                    text: apk_path;
                                    edited(t) => { apk_path = t; }
                                    height: 34px;
                                    vertical-stretch: 0;
                                }
                                HorizontalBox {
                                    spacing: 10px;
                                    ActionButton {
                                        text: "Install APK on phone";
                                        variant: "primary";
                                        min-width: 190px;
                                        clicked() => { install_apk(); }
                                    }
                                    ActionButton {
                                        text: "Start SteamVR";
                                        variant: "neutral";
                                        min-width: 150px;
                                        clicked() => { start_steamvr(); }
                                    }
                                }
                            }
                        }

                        Panel {
                            VerticalBox {
                                padding: 18px;
                                spacing: 10px;

                                SectionTitle { text: "Remote PC ⇄ phone (ADB over Tailscale)"; }
                                HorizontalBox {
                                    spacing: 10px;
                                    VerticalBox {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        HintText { text: "ADB path"; }
                                        TextEdit {
                                            text: adb_path;
                                            edited(t) => { adb_path = t; }
                                            height: 34px;
                                            vertical-stretch: 0;
                                        }
                                    }
                                    VerticalBox {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        HintText { text: "Phone endpoint (IP:port)"; }
                                        TextEdit {
                                            text: phone_endpoint;
                                            edited(t) => { phone_endpoint = t; }
                                            height: 34px;
                                            vertical-stretch: 0;
                                        }
                                    }
                                }
                            }
                        }

                        Panel {
                            VerticalBox {
                                padding: 14px;
                                spacing: 4px;
                                SectionTitle { text: "Status"; }
                                HintText { text: general_status; font-size: 12px; }
                            }
                        }
                    }

                    // ==================== DIAGNOSTICS ====================
                    if current_tab == 3 : VerticalBox {
                        padding: 20px;
                        spacing: 14px;

                        Text { text: "DIAGNOSTICS"; font-size: 21px; font-weight: 700; color: #ebebf3; }
                        Text {
                            text: "Readout of the shared-memory status region (bridge-shm).";
                            font-size: 12px;
                            color: #85858f;
                        }

                        Panel {
                            VerticalBox {
                                padding: 18px;
                                spacing: 10px;
                                SectionTitle { text: "Status region"; }
                                Text {
                                    text: diagnostics;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                    color: #aab2c4;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
