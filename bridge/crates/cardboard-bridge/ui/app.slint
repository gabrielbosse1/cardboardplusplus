import { ScrollView, Slider } from "std-widgets.slint";
// Product UI: the setup WizardWindow plus the hub MainWindow (top bar, side
// bar with Stream/Hand/Controls/General pages). BridgeState is the shared
// contract with main.rs — Rust pollers write properties, callbacks invoke
// core actions. Compiled by build.rs via slint-build.
export global Theme {
    in-out property <color> bg: #000000;
    in-out property <color> surface: #1C1C1E;
    in-out property <color> surface2: #2C2C2E;
    in-out property <color> surface3: #3A3A3C;
    in-out property <color> border: #2C2C2E;
    in-out property <color> text-hi: #F5F5F7;
    in-out property <color> text-mid: #A1A1A6;
    in-out property <color> text-dim: #6E6E73;
    in-out property <color> accent: #0A84FF;
    in-out property <color> accent-dim: #0A84FF2E;
    in-out property <color> ok: #30D158;
    in-out property <color> warn: #FFD60A;
    in-out property <color> err: #FF453A;
}
export global BridgeState {
    // Navigation + install flow state (written by the wizard watcher/hub).
    in-out property <int> current-tab: 0;
    in-out property <int> wizard-step: 0;
    in-out property <bool> install-busy: false;
    in-out property <string> install-note: "";
    in-out property <float> install-progress: 0.0;
    in-out property <bool> driver-present: false;
    in-out property <string> steamvr-note: "";
    in-out property <bool> steamvr-running: false;
    // Connection pills + encoder state for the top bar.
    in-out property <bool> driver-connected: false;
    in-out property <bool> phone-connected: false;
    in-out property <bool> encoder-active: false;
    in-out property <string> encoder-name: "gpu";
    in-out property <int> stream-fps: 0;
    in-out property <int> latency-ms: 0;
    in-out property <int> packets-total: 0;
    in-out property <int> gyro-fps: 0;
    in-out property <int> hand-fps: 0;
    // Hand-tracking tab state: toggles, thresholds, detection counts.
    in-out property <int> hands-detected: 0;
    in-out property <int> landmark-count: 21;
    in-out property <bool> hand-enabled: false;
    in-out property <bool> hand-overlay: true;
    in-out property <int> hand-det: 50;
    in-out property <int> hand-pres: 50;
    in-out property <int> hand-track: 50;
    // Controls tab: input mode plus the six gesture slots per hand. Only one hand is
    // edited at a time (gesture-hand picks which) and the mirror flag copies it to the
    // other, which is what the defaults use since a glove is symmetric.
    in-out property <int> input-mode: 1;
in-out property <bool> controls-applied: false;
in-out property <bool> gesture-mirror: true;
// Whether the gesture editor is open over the page. Pure UI state, so it lives here
// rather than in Rust: the editor is a submenu beside the row that opened it, not a card in
// the scroll flow, which is where it used to live and where it fell off the bottom of the page.
in-out property <bool> editor-open: false;
    // Where the row that opened the editor sits, in window coordinates. The submenu is
    // anchored there and clamped back inside the window, so it always lands next to the
    // row the user clicked instead of across the middle of the screen.
    in-out property <length> editor-anchor-x: 0px;
    in-out property <length> editor-anchor-y: 0px;
    in-out property <length> editor-anchor-w: 0px;
    // Row being edited: which hand and which target, in GestureTarget wire order.
    // The gesture table lives in Rust; only the selected row's clauses are loaded here.
    in-out property <int> sel-hand: 0;
    in-out property <int> sel-target: 0;
    // Up to MAX_CONDS_PER_GROUP ANDed clauses, plus one OR alternative. kind -1 leaves
    // a clause out of the group entirely rather than storing a zero threshold, which
    // would read as "curl at least 0%" and always be true.
    in-out property <int> sel-c0-kind: -1;
    in-out property <int> sel-c0-thresh: 70;
    in-out property <int> sel-c1-kind: -1;
    in-out property <int> sel-c1-thresh: 70;
    in-out property <int> sel-c2-kind: -1;
    in-out property <int> sel-c2-thresh: 70;
    in-out property <int> sel-c3-kind: -1;
    in-out property <int> sel-c3-thresh: 70;
    in-out property <int> sel-alt-kind: -1;
    in-out property <int> sel-alt-thresh: 70;
    // Bumping this forces the row-summary callback to re-evaluate when gesture data changes.
    in-out property <int> gesture-generation: 0;
    // Stream settings form (mirrored into apply-settings args).
    in-out property <int> video-width: 2880;
    in-out property <int> video-height: 1620;
    in-out property <int> fps: 60;
    in-out property <int> bitrate: 20;
    in-out property <int> encoder-index: 0;
    in-out property <float> net-decoded-fps: 0.0;
    in-out property <int> net-stalls: 0;
    in-out property <bool> link-test-active: false;
    in-out property <string> link-test-note: "";
    in-out property <string> phone-ip: "0.0.0.0";
    in-out property <string> log-text: "";
    in-out property <string> app-version: "0.1.0";
    // Preview + camera frames and stream health (fast poller).
    in-out property <int> preview-driver-fps: 0;
    in-out property <int> preview-bitrate-kbps: 0;
    in-out property <int> preview-frames: 0;
    in-out property <int> preview-drops: 0;
    in-out property <image> preview-frame: @image-url("icons/stream.svg");
    in-out property <image> camera-frame: @image-url("icons/hand.svg");
    in-out property <int> camera-fps: 0;
    in-out property <bool> camera-connected: false;
    in-out property <string> gyro-x: "0.00";
    in-out property <string> gyro-y: "0.00";
    in-out property <string> gyro-z: "0.00";
    in-out property <string> accel-x: "0.00";
    in-out property <string> accel-y: "0.00";
    in-out property <string> accel-z: "0.00";
    in-out property <string> mag-x: "0.00";
    in-out property <string> mag-y: "0.00";
    in-out property <string> mag-z: "0.00";
    // Hub actions, each wired in main.rs wire-callbacks to an AppCore method:
    // apply-settings pushes Stream form (w,h,fps,Mbps,encoder-index),
    // wizard-done finishes setup, install-driver runs the 6-stage install,
    // open-steamvr launches via Steam, test-link starts the 10s link test,
    // hand/overlay toggles flip detection vs skeleton paint, apply-hand-model
    // retunes thresholds live (det,pres,track 1-100).
    callback apply-settings(int, int, int, int, int);
    callback wizard-done();
    callback install-driver();
    callback open-steamvr();
    callback dismiss-steamvr-running();
    callback reopen-wizard(int);
    callback test-link();
    callback hand-toggled(bool);
    callback overlay-toggled(bool);
    callback apply-hand-model(int, int, int);
    // Controls tab actions. apply-controls pushes the whole table (mode plus both
    // hands) as one BRIDGE_INPUTS datagram; select-gesture-target asks Rust to load a
    // row into the sel-* properties, set-gesture-target writes the selected row back,
    // mirror-gestures copies left onto right and keeps both hands identical on every
    // edit while checked, reset-gestures restores the defaults.
    // Edits stage locally and only Apply reaches the driver.
    callback apply-controls();
    callback select-gesture-target(int, int);
    callback set-gesture-target(int, int, int, int, int, int, int, int, int, int);
    callback mirror-gestures(bool);
    callback reset-gestures();
    // Per-row lookups back into the gesture table. Rust owns the bindings, and Slint
    // cannot index a fixed-size array by a runtime value, so the row list asks for
    // what it should display rather than holding its own copy. Pure so the bindings
    // that read them can stay in a property expression.
    pure callback row-summary(int, int, int) -> string;
    pure callback row-bound(int, int) -> bool;
    // Display metadata for a GestureTarget index. Pure so the row list and the editor
    // heading can use them inside property expressions.
    pure callback target-part(int) -> int;
    pure callback target-name(int) -> string;
}
// Accent-filled action button; clicked fires only when enabled.
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    border-radius: 9px;
    background: root.enabled ? Theme.accent : Theme.surface3;
    opacity: root.enabled ? 1 : 0.6;
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.enabled ? #FFFFFF : Theme.text-dim;
        font-size: 13px;
        font-weight: 600;
    }
}
// Outlined secondary button, same clicked contract as PrimaryButton.
component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.enabled ? Theme.text-hi : Theme.text-dim;
        font-size: 13px;
        font-weight: 500;
    }
}
// Labeled number stepper bound two-way to value within min..max; used by
// the Stream form (resolution/fps/bitrate rows).
component Stepper inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> min;
    in property <int> max;
    in property <int> step: 1;
    in property <string> unit: "";
    callback changed(int);
    spacing: 10px;
    height: 36px;
    cross-axis-alignment: center;
    Text {
        text: root.label;
        color: Theme.text-mid;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    Rectangle {
        width: 120px;
        height: 34px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.value + root.unit;
            color: Theme.text-hi;
            font-size: 14px;
            font-weight: 600;
        }
    }
    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface2;
        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                if root.value - root.step >= root.min {
                    root.value -= root.step;
                    root.changed(root.value);
                }
            }
        }
        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "-";
            color: Theme.text-hi;
            font-size: 15px;
        }
    }
    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface2;
        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                if root.value + root.step <= root.max {
                    root.value += root.step;
                    root.changed(root.value);
                }
            }
        }
        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "+";
            color: Theme.text-hi;
            font-size: 15px;
        }
    }
}
// Labeled on/off switch; changed(bool) drives the hand/overlay toggles.
component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback changed(bool);
    height: 30px;
    border-radius: 15px;
    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            color: Theme.text-mid;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 46px;
            height: 26px;
            border-radius: 13px;
            border-width: 1px;
            border-color: Theme.border;
            background: root.checked ? Theme.accent : Theme.surface2;
            Rectangle {
                width: 19px;
                height: 19px;
                y: 2.5px;
                x: root.checked ? 24px : 2px;
                border-radius: 9.5px;
                background: #FFFFFF;
                animate x {
                    duration: 150ms;
                }
            }
            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.changed(root.checked);
                }
            }
        }
    }
}
// Selectable chip (encoder picker); active highlights, clicked selects.
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active ? Theme.accent-dim : Theme.surface2;
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    Text {
        x: 14px;
        y: 0;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.active ? Theme.text-hi : Theme.text-mid;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
    }
}
// Non-interactive status pill: label plus detail, green when ok. Used for
// the connection indicators in the top bar.
component StatusPill inherits Rectangle {
    in property <string> label;
    in property <string> detail: "";
    in property <bool> ok;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        cross-axis-alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.ok ? Theme.ok : Theme.text-dim;
        }
        Text {
            text: root.detail == "" ? root.label : root.label + " · " + root.detail;
            color: root.ok ? Theme.text-hi : Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}
// Thin progress fill for driver installs, driven by install-progress.
component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    height: 6px;
    border-radius: 3px;
    background: Theme.surface3;
    clip: true;
    Rectangle {
        x: 0;
        y: 0;
        height: 100%;
        width: parent.width * Math.min(Math.max(root.progress, 0.0), 1.0);
        border-radius: 3px;
        background: Theme.accent;
        animate width {
            duration: 200ms;
        }
    }
}
// Titled settings card grouping one concern (stream, camera, install).
component Card inherits Rectangle {
    in property <string> title;
    in property <string> hint: "";
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 14px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.title;
            color: Theme.text-hi;
            font-size: 13px;
            font-weight: 600;
        }
        if root.hint != "" : Text {
            text: root.hint;
            color: Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }
        @children
    }
}
// Large label/value tile for headline stats (fps, bitrate, hands).
component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value: "";
    in property <color> value-color: Theme.text-hi;
    height: 78px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}
// Compact label/value tile for dense grids (gyro axes, net stats).
component MiniMetric inherits Rectangle {
    in property <string> label;
    in property <string> value: "";
    in property <color> value-color: Theme.text-hi;
    height: 52px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;
    VerticalLayout {
        padding: 6px;
        spacing: 0px;
        alignment: center;
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}
// Sidebar tab with icon; active highlights, clicked sets current-tab.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked;
    height: 44px;
    border-radius: 10px;
    background: root.active ? Theme.surface3 : transparent;
    Rectangle {
        x: 0;
        width: 3px;
        height: 20px;
        y: (parent.height - 20px) / 2;
        border-radius: 2px;
        background: root.active ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding: 4px;
        padding-left: 16px;
        spacing: 12px;
        height: 100%;
        Image {
            width: 21px;
            height: 21px;
            source: root.icon;
            colorize: root.active ? Theme.text-hi : Theme.text-dim;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-hi : Theme.text-dim;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
// Hub header: title, version, and the driver/phone/encoder StatusPills.
component TopBar inherits Rectangle {
    height: 62px;
    background: Theme.surface;
    Rectangle {
        width: 100%;
        height: 1px;
        y: parent.height - 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 13px;
        cross-axis-alignment: center;
        Image {
            source: @image-url("icons/logo.png");
            width: 32px;
            height: 32px;
        }
        VerticalLayout {
            spacing: 1px;
            Text {
                text: "Cardboard++";
                color: Theme.text-hi;
                font-size: 15px;
                font-weight: 700;
            }
            Text {
                text: "Control plane for the streaming driver";
                color: Theme.text-dim;
                font-size: 11px;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        StatusPill {
            label: "Stream";
            detail: BridgeState.stream-fps + " fps";
            ok: BridgeState.driver-connected;
        }
        StatusPill {
            label: "Phone";
            detail: BridgeState.gyro-fps + "/s";
            ok: BridgeState.phone-connected;
        }
        StatusPill {
            label: "Hands";
            detail: BridgeState.hand-fps + " fps";
            ok: BridgeState.hand-enabled;
        }
        StatusPill {
            label: "Camera";
            detail: BridgeState.camera-fps + " fps";
            ok: BridgeState.camera-connected;
        }
    }
}
// Left tab rail switching current-tab between Stream/Hand/Controls/General.
component Sidebar inherits Rectangle {
    width: 216px;
    background: Theme.surface;
    Rectangle {
        width: 1px;
        x: parent.width - 1px;
        height: 100%;
        background: Theme.border;
    }
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: "CONTROL PLANE";
            color: Theme.text-dim;
            font-size: 10px;
        }
        for t in [
            { index: 0, label: "Stream", icon: @image-url("icons/stream.svg") },
            { index: 1, label: "Hand Tracking", icon: @image-url("icons/hand.svg") },
            { index: 2, label: "Controls", icon: @image-url("icons/controls.svg") },
            { index: 3, label: "General", icon: @image-url("icons/general.svg") },
        ] : TabButton {
            label: t.label;
            icon: t.icon;
            active: BridgeState.current-tab == t.index;
            clicked => {
                BridgeState.current-tab = t.index;
            }
        }
        Rectangle {
            height: 1px;
            horizontal-stretch: 1;
            background: Theme.border;
        }
        Text {
            text: "Video stays direct:\nPC → phone (UDP 42069)";
            color: Theme.text-dim;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}
// Hub footer: install note plus progress bar during driver installs.
component BottomBar inherits Rectangle {
    height: 28px;
    background: #000000;
    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            text: "Cardboard++  ·  v" + BridgeState.app-version;
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Text {
            text: "GPL-3.0 · control plane for the SteamVR driver";
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
// Stream tab: resolution/fps/bitrate steppers, encoder pills, Apply (calls
// apply-settings), link test row, and the ffmpeg preview image.
component StreamPage inherits HorizontalLayout {
    spacing: 14px;
    padding: 20px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 14px;
        Text {
            text: "STATS";
            color: Theme.text-dim;
            font-size: 10px;
        }
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 0px;
                            alignment: center;
                            Text {
                                text: "PC · SteamVR driver";
                                color: BridgeState.driver-connected ? Theme.text-hi : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: BridgeState.driver-connected ? "encoding & streaming" : "not connected";
                                color: BridgeState.driver-connected ? Theme.ok : Theme.err;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: "→";
                        color: Theme.text-mid;
                        font-size: 18px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;
                        VerticalLayout {
                            padding: 6px;
                            spacing: 0px;
                            alignment: center;
                            Text {
                                text: "Phone · MediaCodec";
                                color: BridgeState.phone-connected ? Theme.text-hi : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: BridgeState.video-width + "×" + BridgeState.video-height + " @ " + BridgeState.fps + " fps";
                                color: Theme.text-mid;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "UDP 42069 · raw H.264 Annex-B (no length prefix)";
                    color: Theme.text-dim;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                GridLayout {
                    spacing: 8px;
                    Row {
                        MiniMetric {
                            label: "Resolution (SBS)";
                            value: BridgeState.video-width + "×" + BridgeState.video-height;
                            horizontal-stretch: 1;
                        }
                        MiniMetric {
                            label: "Target FPS";
                            value: BridgeState.fps + " fps";
                            horizontal-stretch: 1;
                        }
                    }
                    Row {
                        MiniMetric {
                            label: "Bitrate";
                            value: BridgeState.bitrate + " Mbps";
                            horizontal-stretch: 1;
                        }
                        MiniMetric {
                            label: "Latency";
                            value: BridgeState.latency-ms + " ms";
                            value-color: BridgeState.latency-ms < 60 ? Theme.ok : (BridgeState.latency-ms < 120 ? Theme.warn : Theme.err);
                            horizontal-stretch: 1;
                        }
                    }
                    Row {
                        MiniMetric {
                            label: "Phone Decode";
                            value: Math.round(BridgeState.net-decoded-fps) + " fps";
                            horizontal-stretch: 1;
                        }
                        MiniMetric {
                            label: "Link Stalls";
                            value: BridgeState.net-stalls + "";
                            value-color: BridgeState.net-stalls > 0 ? Theme.warn : Theme.text-hi;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
        Text {
            text: "VIEWER · STEAMVR";
            color: Theme.text-dim;
            font-size: 10px;
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 140px;
            border-radius: 12px;
            clip: true;
            background: #000;
            border-width: 1px;
            border-color: Theme.border;
            Image {
                source: BridgeState.preview-frame;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
    }
    ScrollView {
        width: 380px;
        horizontal-scrollbar-policy: always-off;
        viewport-height: right-col.preferred-height;
        right-col := VerticalLayout {
            spacing: 14px;
            width: parent.width;
    Text {
        text: "OPTIONS";
        color: Theme.text-dim;
        font-size: 10px;
    }
    Card {
        title: "Preview";
        hint: "The driver's localhost copy (UDP 127.0.0.1:42069), decoded live inside the bridge. The phone stream is unaffected.";
        Text {
            text: BridgeState.preview-frames > 0 ? "Local preview: streaming" : "Local preview: waiting for the driver…";
            color: BridgeState.preview-frames > 0 ? Theme.ok : Theme.text-dim;
            font-size: 13px;
            font-weight: 600;
            wrap: word-wrap;
        }
        GridLayout {
            spacing: 12px;
            Row {
                Metric {
                    label: "Driver FPS";
                    value: BridgeState.preview-driver-fps + "";
                    horizontal-stretch: 1;
                }
                Metric {
                    label: "Bitrate";
                    value: BridgeState.preview-bitrate-kbps + " kbps";
                    horizontal-stretch: 1;
                }
            }
            Row {
                Metric {
                    label: "Frames sent";
                    value: BridgeState.preview-frames + "";
                    horizontal-stretch: 1;
                }
                Metric {
                    label: "Dropped";
                    value: BridgeState.preview-drops + "";
                    value-color: BridgeState.preview-drops > 0 ? Theme.warn : Theme.text-hi;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    Card {
        title: "Encoder";
        hint: "GPU lets the driver pick the hardware backend for your card (AMF → NVENC → QSV, libx264 fallback). CPU forces software encoding.";
        HorizontalLayout {
            spacing: 10px;
            Pill {
                text: "GPU";
                active: BridgeState.encoder-index == 0;
                horizontal-stretch: 1;
                clicked => {
                    BridgeState.encoder-index = 0;
                }
            }
            Pill {
                text: "CPU";
                active: BridgeState.encoder-index == 1;
                horizontal-stretch: 1;
                clicked => {
                    BridgeState.encoder-index = 1;
                }
            }
        }
    }
    Card {
        title: "Picture";
        hint: "Resolution is clamped by the phone's hardware decoder cap. Settings push to the driver over UDP 42070 when you apply.";
        VerticalLayout {
            spacing: 12px;
            Stepper {
                label: "Resolution width (SBS)";
                value: BridgeState.video-width;
                min: 1280;
                max: 5760;
                step: 160;
                changed(v) => {
                    BridgeState.video-width = v;
                }
            }
            Stepper {
                label: "Resolution height";
                value: BridgeState.video-height;
                min: 720;
                max: 3240;
                step: 90;
                changed(v) => {
                    BridgeState.video-height = v;
                }
            }
            Stepper {
                label: "Target FPS";
                value: BridgeState.fps;
                min: 15;
                max: 120;
                step: 5;
                changed(v) => {
                    BridgeState.fps = v;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                height: 36px;
                cross-axis-alignment: center;
                Text {
                    text: "Bitrate (Mbps)";
                    color: Theme.text-mid;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Slider {
                    minimum: 2;
                    maximum: 40;
                    value: BridgeState.bitrate;
                    horizontal-stretch: 2;
                    changed(v) => {
                        BridgeState.bitrate = Math.round(v);
                    }
                }
                Text {
                    text: BridgeState.bitrate + " Mbps";
                    color: Theme.text-hi;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 76px;
                    horizontal-alignment: right;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        SecondaryButton {
            text: BridgeState.link-test-active ? "Testing Link… (≈10s)" : "Test Link";
            enabled: BridgeState.driver-connected && BridgeState.phone-connected && !BridgeState.link-test-active;
            horizontal-stretch: 1;
            clicked => {
                BridgeState.test-link();
            }
        }
        PrimaryButton {
            text: "Apply to Driver";
            enabled: BridgeState.driver-connected;
            horizontal-stretch: 1;
            clicked => {
                BridgeState.apply-settings(BridgeState.video-width, BridgeState.video-height, BridgeState.fps, BridgeState.bitrate, BridgeState.encoder-index);
            }
        }
    }
    Text {
        text: BridgeState.link-test-note;
        color: Theme.text-mid;
        font-size: 12px;
        wrap: word-wrap;
        visible: BridgeState.link-test-note != "";
    }
        }
    }
}
// Hand tab: detection/overlay toggles, threshold sliders (call
// apply-hand-model), hand count metric, and the camera frame with skeleton.
component HandPage inherits HorizontalLayout {
    spacing: 14px;
    padding: 20px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 14px;
