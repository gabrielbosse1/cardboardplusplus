import { ScrollView, Slider } from "std-widgets.slint";

export global Theme {
    in-out property <color> bg: #000000;
    in-out property <color> surface: #1C1C1E;
    in-out property <color> surface2: #2C2C2E;
    in-out property <color> surface3: #3A3A3C;
    in-out property <color> border: #2C2C2E;
    in-out property <color> text-hi: #F5F5F7;
    in-out property <color> text-mid: #A1A1A6;
    in-out property <color> text-dim: #6E6E73;
    in-out property <color> accent: #0A84FF;
    in-out property <color> accent-dim: #0A84FF2E;
    in-out property <color> ok: #30D158;
    in-out property <color> warn: #FFD60A;
    in-out property <color> err: #FF453A;
}

export global BridgeState {
    in-out property <int> current-tab: 0;
    in-out property <int> wizard-step: 0;
    in-out property <bool> install-busy: false;
    in-out property <string> install-note: "";
    in-out property <bool> driver-present: false;
    in-out property <string> steamvr-note: "";

    in-out property <bool> driver-connected: false;
    in-out property <bool> phone-connected: false;
    in-out property <bool> encoder-active: false;
    in-out property <string> encoder-name: "gpu";

    in-out property <int> stream-fps: 0;
    in-out property <int> latency-ms: 0;
    in-out property <int> packets-total: 0;
    in-out property <int> gyro-fps: 0;
    in-out property <int> hand-fps: 0;
    in-out property <int> hands-detected: 0;
    in-out property <int> landmark-count: 21;

    in-out property <bool> hand-enabled: false;
    in-out property <bool> hand-overlay: true;
    in-out property <int> hand-det: 50;
    in-out property <int> hand-pres: 50;
    in-out property <int> hand-track: 50;

    in-out property <int> video-width: 2880;
    in-out property <int> video-height: 1620;
    in-out property <int> fps: 60;
    in-out property <int> bitrate: 20;
    in-out property <int> encoder-index: 0;

    in-out property <float> net-decoded-fps: 0.0;
    in-out property <int> net-stalls: 0;
    in-out property <bool> link-test-active: false;
    in-out property <string> link-test-note: "";

    in-out property <string> phone-ip: "0.0.0.0";
    in-out property <string> log-text: "";
    in-out property <string> app-version: "0.1.0";

    in-out property <int> preview-driver-fps: 0;
    in-out property <int> preview-bitrate-kbps: 0;
    in-out property <int> preview-frames: 0;
    in-out property <int> preview-drops: 0;
    in-out property <image> preview-frame: @image-url("icons/stream.svg");
    in-out property <image> camera-frame: @image-url("icons/hand.svg");
    in-out property <int> camera-fps: 0;
    in-out property <bool> camera-connected: false;

    in-out property <string> gyro-x: "0.00";
    in-out property <string> gyro-y: "0.00";
    in-out property <string> gyro-z: "0.00";
    in-out property <string> accel-x: "0.00";
    in-out property <string> accel-y: "0.00";
    in-out property <string> accel-z: "0.00";
    in-out property <string> mag-x: "0.00";
    in-out property <string> mag-y: "0.00";
    in-out property <string> mag-z: "0.00";

    callback apply-settings(int, int, int, int, int);
    callback wizard-done();
    callback install-driver();
    callback open-steamvr();
    callback reopen-wizard(int);
    callback test-link();
    callback hand-toggled(bool);
    callback overlay-toggled(bool);
    callback apply-hand-model(int, int, int);
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;

    height: 38px;
    border-radius: 9px;
    background: root.enabled ? Theme.accent : Theme.surface3;
    opacity: root.enabled ? 1 : 0.6;

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.enabled ? #FFFFFF : Theme.text-dim;
        font-size: 13px;
        font-weight: 600;
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;

    height: 38px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.enabled ? Theme.text-hi : Theme.text-dim;
        font-size: 13px;
        font-weight: 500;
    }
}

component Stepper inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;
    in property <int> min;
    in property <int> max;
    in property <int> step: 1;
    in property <string> unit: "";
    callback changed(int);

    spacing: 10px;
    height: 36px;
    cross-axis-alignment: center;

    Text {
        text: root.label;
        color: Theme.text-mid;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }

    Rectangle {
        width: 120px;
        height: 34px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;

        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.value + root.unit;
            color: Theme.text-hi;
            font-size: 14px;
            font-weight: 600;
        }
    }

    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface2;

        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                if root.value - root.step >= root.min {
                    root.value -= root.step;
                    root.changed(root.value);
                }
            }
        }

        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "-";
            color: Theme.text-hi;
            font-size: 15px;
        }
    }

    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface2;

        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                if root.value + root.step <= root.max {
                    root.value += root.step;
                    root.changed(root.value);
                }
            }
        }

        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "+";
            color: Theme.text-hi;
            font-size: 15px;
        }
    }
}

component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback changed(bool);

    height: 30px;
    border-radius: 15px;

    HorizontalLayout {
        spacing: 12px;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            color: Theme.text-mid;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 46px;
            height: 26px;
            border-radius: 13px;
            border-width: 1px;
            border-color: Theme.border;
            background: root.checked ? Theme.accent : Theme.surface2;

            Rectangle {
                width: 19px;
                height: 19px;
                y: 2.5px;
                x: root.checked ? 24px : 2px;
                border-radius: 9.5px;
                background: #FFFFFF;

                animate x {
                    duration: 150ms;
                }
            }

            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.changed(root.checked);
                }
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 34px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active ? Theme.accent-dim : Theme.surface2;

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        x: 14px;
        y: 0;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.active ? Theme.text-hi : Theme.text-mid;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <string> detail: "";
    in property <bool> ok;

    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        cross-axis-alignment: center;

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.ok ? Theme.ok : Theme.text-dim;
        }

        Text {
            text: root.detail == "" ? root.label : root.label + " · " + root.detail;
            color: root.ok ? Theme.text-hi : Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> hint: "";

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 14px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: root.title;
            color: Theme.text-hi;
            font-size: 13px;
            font-weight: 600;
        }

        if root.hint != "" : Text {
            text: root.hint;
            color: Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }

        @children
    }
}

component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value: "";
    in property <color> value-color: Theme.text-hi;

    height: 78px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        alignment: center;

        Text {
            text: root.value;
            color: root.value-color;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}

component MiniMetric inherits Rectangle {
    in property <string> label;
    in property <string> value: "";
    in property <color> value-color: Theme.text-hi;

    height: 52px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface2;

    VerticalLayout {
        padding: 6px;
        spacing: 0px;
        alignment: center;

        Text {
            text: root.value;
            color: root.value-color;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked;

    height: 44px;
    border-radius: 10px;
    background: root.active ? Theme.surface3 : transparent;

    Rectangle {
        x: 0;
        width: 3px;
        height: 20px;
        y: (parent.height - 20px) / 2;
        border-radius: 2px;
        background: root.active ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding: 4px;
        padding-left: 16px;
        spacing: 12px;
        height: 100%;

        Image {
            width: 21px;
            height: 21px;
            source: root.icon;
            colorize: root.active ? Theme.text-hi : Theme.text-dim;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.active ? Theme.text-hi : Theme.text-dim;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component TopBar inherits Rectangle {
    height: 62px;
    background: Theme.surface;

    Rectangle {
        width: 100%;
        height: 1px;
        y: parent.height - 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 13px;
        cross-axis-alignment: center;

        Image {
            source: @image-url("icons/logo.png");
            width: 32px;
            height: 32px;
        }

        VerticalLayout {
            spacing: 1px;

            Text {
                text: "Cardboard++ Bridge";
                color: Theme.text-hi;
                font-size: 15px;
                font-weight: 700;
            }

            Text {
                text: "Control plane for the streaming driver";
                color: Theme.text-dim;
                font-size: 11px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        StatusPill {
            label: "Stream";
            detail: BridgeState.stream-fps + " fps";
            ok: BridgeState.driver-connected;
        }

        StatusPill {
            label: "Phone";
            detail: BridgeState.gyro-fps + "/s";
            ok: BridgeState.phone-connected;
        }

        StatusPill {
            label: "Hands";
            detail: BridgeState.hand-fps + " fps";
            ok: BridgeState.hand-enabled;
        }

        StatusPill {
            label: "Camera";
            detail: BridgeState.camera-fps + " fps";
            ok: BridgeState.camera-connected;
        }
    }
}

component Sidebar inherits Rectangle {
    width: 216px;
    background: Theme.surface;

    Rectangle {
        width: 1px;
        x: parent.width - 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        Text {
            text: "CONTROL PLANE";
            color: Theme.text-dim;
            font-size: 10px;
        }

        for t in [
            { index: 0, label: "Stream", icon: @image-url("icons/stream.svg") },
            { index: 1, label: "Hand Tracking", icon: @image-url("icons/hand.svg") },
            { index: 2, label: "Diagnostics", icon: @image-url("icons/diagnostics.svg") },
            { index: 3, label: "General", icon: @image-url("icons/general.svg") },
        ] : TabButton {
            label: t.label;
            icon: t.icon;
            active: BridgeState.current-tab == t.index;
            clicked => {
                BridgeState.current-tab = t.index;
            }
        }

        Rectangle {
            height: 1px;
            horizontal-stretch: 1;
            background: Theme.border;
        }

        Text {
            text: "Video stays direct:\nPC → phone (UDP 42069)";
            color: Theme.text-dim;
            font-size: 10px;
            wrap: word-wrap;
        }
    }
}

component BottomBar inherits Rectangle {
    height: 28px;
    background: #000000;

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;

        Text {
            text: "Cardboard++ Bridge  ·  v" + BridgeState.app-version;
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "GPL-3.0 · control plane for the SteamVR driver";
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component StreamPage inherits HorizontalLayout {
    spacing: 14px;
    padding: 20px;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 14px;

        Text {
            text: "STATS";
            color: Theme.text-dim;
            font-size: 10px;
        }

        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 0px;
                            alignment: center;

                            Text {
                                text: "PC · SteamVR driver";
                                color: BridgeState.driver-connected ? Theme.text-hi : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: BridgeState.driver-connected ? "encoding & streaming" : "not connected";
                                color: BridgeState.driver-connected ? Theme.ok : Theme.err;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "→";
                        color: Theme.text-mid;
                        font-size: 18px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 0px;
                            alignment: center;

                            Text {
                                text: "Phone · MediaCodec";
                                color: BridgeState.phone-connected ? Theme.text-hi : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: BridgeState.video-width + "×" + BridgeState.video-height + " @ " + BridgeState.fps + " fps";
                                color: Theme.text-mid;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: "UDP 42069 · raw H.264 Annex-B (no length prefix)";
                    color: Theme.text-dim;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                GridLayout {
                    spacing: 8px;

                    Row {
                        MiniMetric {
                            label: "Resolution (SBS)";
                            value: BridgeState.video-width + "×" + BridgeState.video-height;
                            horizontal-stretch: 1;
                        }

                        MiniMetric {
                            label: "Target FPS";
                            value: BridgeState.fps + " fps";
                            horizontal-stretch: 1;
                        }
                    }

                    Row {
                        MiniMetric {
                            label: "Bitrate";
                            value: BridgeState.bitrate + " Mbps";
                            horizontal-stretch: 1;
                        }

                        MiniMetric {
                            label: "Latency";
                            value: BridgeState.latency-ms + " ms";
                            value-color: BridgeState.latency-ms < 60 ? Theme.ok : (BridgeState.latency-ms < 120 ? Theme.warn : Theme.err);
                            horizontal-stretch: 1;
                        }
                    }

                    Row {
                        MiniMetric {
                            label: "Phone Decode";
                            value: Math.round(BridgeState.net-decoded-fps) + " fps";
                            horizontal-stretch: 1;
                        }

                        MiniMetric {
                            label: "Link Stalls";
                            value: BridgeState.net-stalls + "";
                            value-color: BridgeState.net-stalls > 0 ? Theme.warn : Theme.text-hi;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        Text {
            text: "VIEWER · STEAMVR";
            color: Theme.text-dim;
            font-size: 10px;
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 140px;
            border-radius: 12px;
            clip: true;
            background: #000;
            border-width: 1px;
            border-color: Theme.border;

            Image {
                source: BridgeState.preview-frame;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }
    }

    ScrollView {
        width: 380px;
        horizontal-scrollbar-policy: always-off;
        viewport-height: right-col.preferred-height;
        right-col := VerticalLayout {
            spacing: 14px;
            width: parent.width;

    Text {
        text: "OPTIONS";
        color: Theme.text-dim;
        font-size: 10px;
    }

    Card {
        title: "Preview";
        hint: "The driver's localhost copy (UDP 127.0.0.1:42069), decoded live inside the bridge. The phone stream is unaffected.";

        Text {
            text: BridgeState.preview-frames > 0 ? "Local preview: streaming" : "Local preview: waiting for the driver…";
            color: BridgeState.preview-frames > 0 ? Theme.ok : Theme.text-dim;
            font-size: 13px;
            font-weight: 600;
            wrap: word-wrap;
        }

        GridLayout {
            spacing: 12px;

            Row {
                Metric {
                    label: "Driver FPS";
                    value: BridgeState.preview-driver-fps + "";
                    horizontal-stretch: 1;
                }

                Metric {
                    label: "Bitrate";
                    value: BridgeState.preview-bitrate-kbps + " kbps";
                    horizontal-stretch: 1;
                }
            }

            Row {
                Metric {
                    label: "Frames sent";
                    value: BridgeState.preview-frames + "";
                    horizontal-stretch: 1;
                }

                Metric {
                    label: "Dropped";
                    value: BridgeState.preview-drops + "";
                    value-color: BridgeState.preview-drops > 0 ? Theme.warn : Theme.text-hi;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    Card {
        title: "Encoder";
        hint: "GPU lets the driver pick the hardware backend for your card (AMF → NVENC → QSV, libx264 fallback). CPU forces software encoding.";

        HorizontalLayout {
            spacing: 10px;

            Pill {
                text: "GPU";
                active: BridgeState.encoder-index == 0;
                horizontal-stretch: 1;
                clicked => {
                    BridgeState.encoder-index = 0;
                }
            }

            Pill {
                text: "CPU";
                active: BridgeState.encoder-index == 1;
                horizontal-stretch: 1;
                clicked => {
                    BridgeState.encoder-index = 1;
                }
            }
        }
    }

    Card {
        title: "Picture";
        hint: "Resolution is clamped by the phone's hardware decoder cap. Settings push to the driver over UDP 42070 when you apply.";

        VerticalLayout {
            spacing: 12px;

            Stepper {
                label: "Resolution width (SBS)";
                value: BridgeState.video-width;
                min: 1280;
                max: 5760;
                step: 160;
                changed(v) => {
                    BridgeState.video-width = v;
                }
            }

            Stepper {
                label: "Resolution height";
                value: BridgeState.video-height;
                min: 720;
                max: 3240;
                step: 90;
                changed(v) => {
                    BridgeState.video-height = v;
                }
            }

            Stepper {
                label: "Target FPS";
                value: BridgeState.fps;
                min: 15;
                max: 120;
                step: 5;
                changed(v) => {
                    BridgeState.fps = v;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                height: 36px;
                cross-axis-alignment: center;

                Text {
                    text: "Bitrate (Mbps)";
                    color: Theme.text-mid;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                Slider {
                    minimum: 2;
                    maximum: 40;
                    value: BridgeState.bitrate;
                    horizontal-stretch: 2;
                    changed(v) => {
                        BridgeState.bitrate = Math.round(v);
                    }
                }

                Text {
                    text: BridgeState.bitrate + " Mbps";
                    color: Theme.text-hi;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 76px;
                    horizontal-alignment: right;
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 10px;

        SecondaryButton {
            text: BridgeState.link-test-active ? "Testing Link… (≈10s)" : "Test Link";
            enabled: BridgeState.driver-connected && BridgeState.phone-connected && !BridgeState.link-test-active;
            horizontal-stretch: 1;
            clicked => {
                BridgeState.test-link();
            }
        }

        PrimaryButton {
            text: "Apply to Driver";
            enabled: BridgeState.driver-connected;
            horizontal-stretch: 1;
            clicked => {
                BridgeState.apply-settings(BridgeState.video-width, BridgeState.video-height, BridgeState.fps, BridgeState.bitrate, BridgeState.encoder-index);
            }
        }
    }

    Text {
        text: BridgeState.link-test-note;
        color: Theme.text-mid;
        font-size: 12px;
        wrap: word-wrap;
        visible: BridgeState.link-test-note != "";
    }
        } // right-col
    } // right ScrollView
}

component HandPage inherits HorizontalLayout {
    spacing: 14px;
    padding: 20px;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 14px;

        Text {
            text: "STATS";
            color: Theme.text-dim;
            font-size: 10px;
        }

        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 14px;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 0px;
                            alignment: center;

                            Text {
                                text: "Phone · Camera";
                                color: BridgeState.camera-connected ? Theme.text-hi : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: BridgeState.camera-connected ? "sending JPEG frames" : "not connected";
                                color: BridgeState.camera-connected ? Theme.ok : Theme.err;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "→";
                        color: Theme.text-mid;
                        font-size: 18px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 46px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 0px;
                            alignment: center;

                            Text {
                                text: "Bridge · MediaPipe";
                                color: BridgeState.hand-enabled ? Theme.text-hi : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: BridgeState.hand-enabled ? "detecting hands" : "disabled";
                                color: BridgeState.hand-enabled ? Theme.ok : Theme.err;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: "Camera UDP 42072 · landmarks TCP 42073";
                    color: Theme.text-dim;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                GridLayout {
                    spacing: 8px;

                    Row {
                        MiniMetric {
                            label: "Camera FPS";
                            value: BridgeState.camera-fps + " fps";
                            horizontal-stretch: 1;
                        }

                        MiniMetric {
                            label: "Hands Detected";
                            value: BridgeState.hands-detected + "";
                            horizontal-stretch: 1;
                        }
                    }

                    Row {
                        MiniMetric {
                            label: "Landmarks / Hand";
                            value: BridgeState.landmark-count + "";
                            horizontal-stretch: 1;
                        }

                        MiniMetric {
                            label: "Hand FPS";
                            value: BridgeState.hand-fps + " fps";
                            horizontal-stretch: 1;
                        }
                    }

                    Row {
                        MiniMetric {
                            label: "Detection Conf";
                            value: BridgeState.hand-det + "%";
                            horizontal-stretch: 1;
                        }

                        MiniMetric {
                            label: "Presence Conf";
                            value: BridgeState.hand-pres + "%";
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        Text {
            text: "VIEWER · PHONE CAMERA";
            color: Theme.text-dim;
            font-size: 10px;
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 140px;
            border-radius: 12px;
            clip: true;
            background: #000;
            border-width: 1px;
            border-color: Theme.border;

            Image {
                source: BridgeState.camera-frame;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
    }

    ScrollView {
        width: 380px;
        horizontal-scrollbar-policy: always-off;
        viewport-height: hand-right-col.preferred-height;
        hand-right-col := VerticalLayout {
            spacing: 14px;
            width: parent.width;

            Text {
                text: "OPTIONS";
                color: Theme.text-dim;
                font-size: 10px;
            }

            Card {
                title: "Status";

                if !BridgeState.hand-enabled : Text {
                    text: "Hand tracking is disabled. Frames are not being requested from the phone.";
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                if BridgeState.hand-enabled && BridgeState.hands-detected == 0 : Text {
                    text: "No hands detected yet. Keep your hands in the phone camera frustum.";
                    color: Theme.warn;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                if BridgeState.hand-enabled && BridgeState.hands-detected > 0 : Text {
                    text: "Tracking active.";
                    color: Theme.ok;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            Card {
                title: "Detection Model";
                hint: "MediaPipe Hand Landmarker runs in a Python sidecar (TCP 42073). Applying pushes the new thresholds live — no restart, no dropped frames.";

                Toggle {
                    label: "Enable hand tracking";
                    checked: BridgeState.hand-enabled;
                    changed(b) => {
                        BridgeState.hand-toggled(b);
                    }
                }

                Toggle {
                    label: "Draw skeleton overlay on the camera feed";
                    checked: BridgeState.hand-overlay;
                    changed(b) => {
                        BridgeState.overlay-toggled(b);
                    }
                }

                Stepper {
                    label: "Detection confidence";
                    value: BridgeState.hand-det;
                    min: 1;
                    max: 100;
                    step: 5;
                    unit: "%";
                    changed(v) => {
                        BridgeState.hand-det = v;
                    }
                }

                Stepper {
                    label: "Presence confidence";
                    value: BridgeState.hand-pres;
                    min: 1;
                    max: 100;
                    step: 5;
                    unit: "%";
                    changed(v) => {
                        BridgeState.hand-pres = v;
                    }
                }

                Stepper {
                    label: "Tracking confidence";
                    value: BridgeState.hand-track;
                    min: 1;
                    max: 100;
                    step: 5;
                    unit: "%";
                    changed(v) => {
                        BridgeState.hand-track = v;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    Metric {
                        label: "Hands Detected";
                        value: BridgeState.hands-detected + "";
                        horizontal-stretch: 1;
                    }

                    Metric {
                        label: "Landmarks / Hand";
                        value: BridgeState.landmark-count + "";
                        horizontal-stretch: 1;
                    }

                    Metric {
                        label: "Hand FPS";
                        value: BridgeState.hand-fps + " fps";
                        horizontal-stretch: 1;
                    }
                }
            }

            PrimaryButton {
                text: "Apply Model Settings";
                clicked => {
                    BridgeState.apply-hand-model(BridgeState.hand-det, BridgeState.hand-pres, BridgeState.hand-track);
                }
            }
        }
    }
}

component DiagnosticsPage inherits VerticalLayout {
    spacing: 14px;
    padding: 20px;

    Text {
        text: "Diagnostics";
        color: Theme.text-hi;
        font-size: 22px;
        font-weight: 700;
    }

    HorizontalLayout {
        spacing: 12px;

        Metric {
            label: "Stream FPS";
            value: BridgeState.stream-fps + "";
            horizontal-stretch: 1;
        }

        Metric {
            label: "Encoder";
            value: BridgeState.encoder-name;
            horizontal-stretch: 1;
        }

        Metric {
            label: "Latency";
            value: BridgeState.latency-ms + " ms";
            horizontal-stretch: 1;
        }

        Metric {
            label: "Gyro Rate";
            value: BridgeState.gyro-fps + "/s";
            horizontal-stretch: 1;
        }
    }

    HorizontalLayout {
        spacing: 12px;

        Metric {
            label: "Hand FPS";
            value: BridgeState.hand-fps + " fps";
            horizontal-stretch: 1;
        }

        Metric {
            label: "Camera FPS";
            value: BridgeState.camera-fps + " fps";
            horizontal-stretch: 1;
        }

        Metric {
            label: "Telemetry Packets";
            value: BridgeState.packets-total + "";
            horizontal-stretch: 1;
        }

        Metric {
            label: "Phone Address";
            value: BridgeState.phone-ip;
            horizontal-stretch: 1;
        }
    }

    Card {
        title: "Installers";
        hint: "Re-install the SteamVR driver (pinned FFmpeg runtimes included) or revisit phone setup.";

        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 10px;
                cross-axis-alignment: center;

                PrimaryButton {
                    width: 170px;
                    text: BridgeState.install-busy ? "Installing…" : "Re-install driver";
                    enabled: !BridgeState.install-busy;
                    clicked => {
                        BridgeState.install-driver();
                    }
                }

                SecondaryButton {
                    width: 170px;
                    text: "Reinstall phone app";
                    clicked => {
                        BridgeState.reopen-wizard(2);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                StatusPill {
                    label: "driver present";
                    ok: BridgeState.driver-present;
                }
            }

            if BridgeState.install-note != "" : Text {
                text: BridgeState.install-note;
                color: Theme.text-mid;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    Card {
        title: "Sensors";
        hint: "Latest phone IMU sample from the telemetry uplink (UDP 42071).";

        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Gyro  " + BridgeState.gyro-x + "  " + BridgeState.gyro-y + "  " + BridgeState.gyro-z + " rad/s";
                color: Theme.text-mid;
                font-size: 12px;
                font-family: "Consolas";
            }

            Text {
                text: "Accel " + BridgeState.accel-x + "  " + BridgeState.accel-y + "  " + BridgeState.accel-z + " m/s²";
                color: Theme.text-mid;
                font-size: 12px;
                font-family: "Consolas";
            }

            Text {
                text: "Mag   " + BridgeState.mag-x + "  " + BridgeState.mag-y + "  " + BridgeState.mag-z + " µT";
                color: Theme.text-mid;
                font-size: 12px;
                font-family: "Consolas";
            }
        }
    }

    Card {
        title: "Bridge log";
        hint: "Newest entries on top.";

        Rectangle {
            width: 100%;
            height: 240px;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            background: #000000;

            Flickable {
                width: 100%;
                height: 100%;

                Text {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    wrap: word-wrap;
                    text: BridgeState.log-text;
                    color: Theme.text-mid;
                    font-size: 12px;
                    font-family: "Consolas";
                }
            }
        }
    }
}

component GeneralPage inherits VerticalLayout {
    spacing: 14px;
    padding: 20px;

    Text {
        text: "General";
        color: Theme.text-hi;
        font-size: 22px;
        font-weight: 700;
    }

    Card {
        title: "Phone Link";

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            Text {
                text: "Telemetry uplink:";
                color: Theme.text-mid;
                font-size: 13px;
                vertical-alignment: center;
            }

            Text {
                text: BridgeState.phone-ip;
                color: BridgeState.phone-connected ? Theme.text-hi : Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            StatusPill {
                label: "reachable";
                ok: BridgeState.phone-connected;
            }
        }

        Text {
            text: "Bridge listens on UDP 42071 for gyro, hand-tracking and ping frames. The video stream never enters the bridge.";
            color: Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    Card {
        title: "Setup wizard";

        HorizontalLayout {
            spacing: 10px;
            cross-axis-alignment: center;

            Text {
                text: "Re-run the guided setup (driver install, phone app, SteamVR).";
                color: Theme.text-mid;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            SecondaryButton {
                width: 190px;
                text: "Back to setup wizard";
                clicked => {
                    BridgeState.reopen-wizard(0);
                }
            }
        }
    }

    Card {
        title: "About";

        Text {
            text: "Bridge v" + BridgeState.app-version + " · control plane for the SteamVR driver · GPL-3.0";
            color: Theme.text-mid;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component WizardWindow inherits Window {
    title: "Cardboard++ setup";
    preferred-width: 560px;
    preferred-height: 600px;
    min-width: 480px;
    min-height: 540px;

    background: Theme.surface;

    VerticalLayout {
        padding: 28px;
        spacing: 14px;

                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;

                        Image {
                            source: @image-url("icons/logo.png");
                            width: 36px;
                            height: 36px;
                        }

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Cardboard++ setup";
                                color: Theme.text-hi;
                                font-size: 17px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Step " + (BridgeState.wizard-step + 1) + " of 4 · skip anytime";
                                color: Theme.text-dim;
                                font-size: 11px;
                            }
                        }

                        SecondaryButton {
                            text: "Skip";
                            width: 72px;
                            clicked => {
                                BridgeState.wizard-done();
                            }
                        }
                    }

                    Rectangle {
                        min-height: 262px;

                    if BridgeState.wizard-step == 0 : VerticalLayout {
                        alignment: start;
                        spacing: 10px;

                        Text {
                            text: "Get started";
                            color: Theme.text-hi;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Cardboard++ turns a cheap Cardboard headset and an Android phone into a full SteamVR system — video and hand tracking together. You need a gaming PC with SteamVR, a Cardboard viewer, and an Android phone on the same Wi-Fi.";
                            color: Theme.text-mid;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    if BridgeState.wizard-step == 1 : VerticalLayout {
                        alignment: start;
                        spacing: 10px;

                        Text {
                            text: "Install the SteamVR driver";
                            color: Theme.text-hi;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        Text {
                            text: BridgeState.driver-present ? "Driver detected inside SteamVR. You can re-install to update, then open SteamVR so it loads." : "One click copies the driver into SteamVR. Then open SteamVR so it loads, and allow the Cardboard++ addon under Settings → Startup/Shutdown → Add-ons.";
                            color: Theme.text-mid;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        PrimaryButton {
                            text: BridgeState.install-busy ? "Installing…" : (BridgeState.driver-present ? "Re-install driver" : "Install driver");
                            enabled: !BridgeState.install-busy;
                            clicked => {
                                BridgeState.install-driver();
                            }
                        }

                        if BridgeState.install-note != "" : Text {
                            text: BridgeState.install-note;
                            color: Theme.text-mid;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        SecondaryButton {
                            text: "Open SteamVR";
                            clicked => {
                                BridgeState.open-steamvr();
                            }
                        }

                        if BridgeState.steamvr-note != "" : Text {
                            text: BridgeState.steamvr-note;
                            color: Theme.text-mid;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    if BridgeState.wizard-step == 2 : VerticalLayout {
                        alignment: start;
                        spacing: 10px;

                        Text {
                            text: "Get the phone app";
                            color: Theme.text-hi;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 14px;

                            Image {
                                source: @image-url("icons/qr-releases.png");
                                width: 150px;
                                height: 150px;
                            }

                            VerticalLayout {
                                spacing: 8px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "1 · Scan the code — it opens the GitHub releases page. Download the APK from there.";
                                    color: Theme.text-mid;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "2 · Android blocks installs at first: when asked, allow “Install unknown apps” for your browser, then open the APK to install it.";
                                    color: Theme.text-mid;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if BridgeState.wizard-step == 3 : VerticalLayout {
                        alignment: start;
                        spacing: 10px;

                        Text {
                            text: "Connect your phone";
                            color: Theme.text-hi;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Open the Cardboard++ app on your phone now (same Wi-Fi as this PC). The hub opens by itself once the phone connects.";
                            color: Theme.text-mid;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: BridgeState.phone-connected ? "Phone connected: " + BridgeState.phone-ip + " — opening hub…" : "Waiting for phone…";
                            color: BridgeState.phone-connected ? Theme.ok : Theme.text-dim;
                            font-size: 13px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                    } // step container — fixed height so text can never reach the buttons

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        for i in [0, 1, 2, 3] : Rectangle {
                            width: i == BridgeState.wizard-step ? 22px : 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: i == BridgeState.wizard-step ? Theme.accent : Theme.surface3;

                            animate width {
                                duration: 150ms;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        SecondaryButton {
                            text: "Back";
                            enabled: BridgeState.wizard-step > 0;
                            horizontal-stretch: 1;
                            clicked => {
                                if BridgeState.wizard-step > 0 {
                                    BridgeState.wizard-step -= 1;
                                }
                            }
                        }

                        PrimaryButton {
                            text: BridgeState.wizard-step < 3 ? "Next" : "Open hub";
                            horizontal-stretch: 1;
                            clicked => {
                                if BridgeState.wizard-step < 3 {
                                    BridgeState.wizard-step += 1;
                                } else {
                                    BridgeState.wizard-done();
                                }
                            }
                        }
                    }
    }
}

export component MainWindow inherits Window {
    title: "Cardboard++ Bridge";
    preferred-width: 1160px;
    preferred-height: 720px;
    min-width: 940px;
    min-height: 560px;

    background: Theme.bg;

    VerticalLayout {
        TopBar {}

        HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            Sidebar {}

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Theme.bg;

                if BridgeState.current-tab == 0 : StreamPage {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                }
                if BridgeState.current-tab == 1 : HandPage {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                }
                if BridgeState.current-tab == 2 : ScrollView {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    horizontal-scrollbar-policy: always-off;
                    s2 := DiagnosticsPage {}
                    viewport-height: s2.preferred-height;
                }
                if BridgeState.current-tab == 3 : ScrollView {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    horizontal-scrollbar-policy: always-off;
                    s3 := GeneralPage {}
                    viewport-height: s3.preferred-height;
                }
            }
        }

        BottomBar {}
    }
}
