# Turns a SPIR-V file into a C header holding it as a uint32 array. Invoked in
# script mode: cmake -DSPV=<in> -DHDR=<out> -DNAME=CBPPSpirv_<name> -P EmbedSpirv.cmake
file(READ "${SPV}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " words "${hex}")
string(REGEX REPLACE "0x([0-9a-f][0-9a-f]), 0x([0-9a-f][0-9a-f]), 0x([0-9a-f][0-9a-f]), 0x([0-9a-f][0-9a-f])"
       "0x\\1\\2\\3\\4u, " words "${words}")
string(REGEX REPLACE ",[ ]*$" "" words "${words}")
file(WRITE "${HDR}"
"// Generated by cmake/EmbedSpirv.cmake from ${SPV}. Do not edit.\n"
"#pragma once\n"
"#include <cstdint>\n"
"static const uint32_t ${NAME}[] = {\n${words}\n};\n")